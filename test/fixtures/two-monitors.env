# Sourced by tests. Builds a two-monitor desk in a temp dir.
setup_two_monitors() {
  export STUB_STATE="$BATS_TEST_TMPDIR/state"
  export STUB_CAPS="$BATS_TEST_TMPDIR/caps"
  export XDG_CONFIG_HOME="$BATS_TEST_TMPDIR/config"
  mkdir -p "$STUB_STATE" "$XDG_CONFIG_HOME/screenpush"
  echo "0x0f" > "$STUB_STATE/AAA0001"
  echo "0x0f" > "$STUB_STATE/BBB0002"
  cat > "$STUB_CAPS" <<'CAPS'
AAA0001 0x0f 0x11 0x12
BBB0002 0x0f 0x11 0x12
CAPS
  PATH="$BATS_TEST_DIRNAME/stub:$PATH"
  export PATH
}

save_office_desk() {
  cat > "$XDG_CONFIG_HOME/screenpush/desks.json" <<'JSON'
{"version":1,"desks":{"AAA0001+BBB0002":{"label":"Office",
 "monitors":[{"serial":"AAA0001","label":"Left","model":"STUB MONITOR"},
             {"serial":"BBB0002","label":"Right","model":"STUB MONITOR"}],
 "computers":[{"id":"this","label":"This machine","host":null,
               "inputs":{"AAA0001":"0x0f","BBB0002":"0x0f"}},
              {"id":"mac","label":"Mac","host":null,
               "inputs":{"AAA0001":"0x11","BBB0002":"0x11"}}]}}}
JSON
}
