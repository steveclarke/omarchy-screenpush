#!/usr/bin/env bash
set -euo pipefail

################################################################################
# lint-qml - type-check this plugin's QML against Omarchy's shell modules
################################################################################
#
# USAGE
# -----
#   tools/lint-qml Panel.qml [more.qml ...]
#
# Prints OK and exits 0 when clean. Prints the linter's own output and exits 1
# otherwise.
#
# WHY THIS EXISTS
# ---------------
# `qmllint -I "$OMARCHY_PATH/shell" Panel.qml` looks right and is useless:
# /usr/bin/qmllint is Qt 5 and exits 255 silently on Quickshell QML, and even
# the Qt 6 binary cannot resolve `qs.Ui` from the shell root, because the
# module is declared `qs.Ui` inside a plain `Ui/` directory. This builds the
# qs/ namespace qmllint expects, in a temp dir, and points it there.
#
################################################################################

QMLLINT=${QMLLINT:-/usr/lib/qt6/bin/qmllint}
SHELL_DIR=${OMARCHY_PATH:-/usr/share/omarchy}/shell

# Warning classes first-party Omarchy plugins emit in quantity. They come from
# QtObject-typed singletons whose members qmllint cannot see statically, not
# from anything wrong. Anything OUTSIDE this list is a real finding.
#
# Both entries were measured, not guessed: linting seven first-party panels
# produces between 16 and 135 of each per file. Keep it that way - an
# allowlist justified by our own output rather than by first-party output is
# self-fulfilling, and every entry added without evidence is a class of defect
# this gate will never report.
ALLOWED='unqualified|missing-property'

# One specific message, tolerated by text rather than added to ALLOWED above.
# Every first-party Process.onExited handler (Reminder.qml, MultiSelect.qml,
# ScreenRecording.qml) trips this: qmllint cannot resolve QProcess::ExitStatus
# for the `exited` signal, regardless of the handler's own parameter list.
# It is not folded into the signal-handler-parameters class because that
# class also fires for a genuinely wrong handler signature, which is a real
# defect this gate should keep catching - suppressing the whole class would
# blind it to that.
TOLERATED='Type QProcess::ExitStatus of parameter exitStatus in signal called exited'

main() {
  [ $# -gt 0 ] || error "usage: tools/lint-qml <file.qml> [...]"
  require_tools

  # Not `local`: the EXIT trap fires after main() returns, at global scope,
  # and under `set -u` a local variable read there is unbound.
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  build_namespace "$work"

  local out
  out=$("$QMLLINT" -I "$work" "$@" 2>&1) || true

  # `unqualified` is allowlisted wholesale, but it also carries "no matching
  # signal found for handler" - a handler for a signal that does not exist,
  # which makes the whole component fail to load at runtime with "Cannot
  # assign to non-existent property". That exact defect shipped here once and
  # cost a working plugin, hidden inside an allowlist entry justified by
  # first-party noise. Anything matching FATAL is a finding whatever class it
  # carries. An allowlist needs a deny list.
  # A required property left unset only WARNS - the component silently
  # refuses to build, so the UI it belongs to never appears. That defect
  # shipped here and read as 'the button does nothing'.
  local fatal='no matching signal found for handler|Required property .* was not initialized'

  local bad
  bad=$(printf '%s\n' "$out" | grep -E '^(Error|Warning):' \
        | grep -vE "\[($ALLOWED)\]$" \
        | grep -vF "$TOLERATED" || true)
  # -E, not -F: `fatal` is an alternation of patterns. A fixed-string match
  # here silently matches nothing, which is how a deny-list quietly stops
  # denying anything.
  bad="${bad}"$'\n'"$(printf '%s\n' "$out" | grep -E "$fatal" || true)"
  bad=$(printf '%s' "$bad" | grep -v '^[[:space:]]*$' || true)

  if [ -n "$bad" ]; then
    printf '%s\n' "$out"
    echo
    error "unexpected qmllint output above"
  fi
  echo "OK"
}

error() { echo "Error: ${1}" >&2; exit 1; }

require_tools() {
  [ -x "$QMLLINT" ] \
    || error "no Qt6 qmllint at ${QMLLINT}. /usr/bin/qmllint is Qt5 and silently passes everything - do not fall back to it."
  [ -d "$SHELL_DIR/Ui" ] || error "no Omarchy shell modules at ${SHELL_DIR}"
}

# qmllint resolves `qs.Ui` by looking for <importpath>/qs/Ui/qmldir, so give
# it exactly that, as symlinks into the real shell directory.
build_namespace() {
  mkdir -p "$1/qs"
  local dir
  for dir in "$SHELL_DIR"/*/; do
    [ -f "${dir}qmldir" ] || continue
    ln -s "${dir%/}" "$1/qs/$(basename "$dir")"
  done
}

main "$@"
