#!/usr/bin/env bash
set -euo pipefail

################################################################################
# screenpush - send every monitor on this desk to a named computer
################################################################################
#
# OVERVIEW
# --------
# Monitors cabled to several computers are switched by setting their DDC/CI
# input source, instead of menu-diving on each monitor's own OSD. Run it on
# whichever machine currently owns the screens; DDC keeps answering on a
# monitor that is displaying some other input, so a machine can always pull
# the screens back to itself.
#
# USAGE
# -----
#   screenpush detect              JSON: monitors present and their inputs
#   screenpush state               JSON: this desk, its computers, live input
#   screenpush switch <id>         send every monitor to that computer
#   screenpush switch <id> --monitor <serial>    just one monitor
#   screenpush switch-raw <serial> <code>  send one monitor to a literal code
#   screenpush reachable <id>      exit 0 if that computer answers a ping
#
# CONFIGURATION
# -------------
# ~/.config/screenpush/desks.json, written by the Omarchy plugin's setup
# screen. Nothing here needs hand-editing.
#
################################################################################

# Every read and write of desks.json goes through this helper, which works on
# descriptors checked for ownership and refuses links. See its header.
DESKFILE="$(dirname "$(readlink -f "$0")")/../lib/deskfile.py"

# shellcheck source=../lib/desk.sh
source "$(dirname "$(readlink -f "$0")")/../lib/desk.sh"

################################################################################
# Main Orchestration
################################################################################

main() {
  local cmd="${1:-}"
  shift || true

  require_deps

  case "$cmd" in
    detect) cmd_detect ;;
    state)  cmd_state ;;
    switch) with_switch_lock cmd_switch "$@" ;;
    switch-raw) with_switch_lock cmd_switch_raw "$@" ;;
    reachable) cmd_reachable "$@" ;;
    save-desk) cmd_save_desk ;;
    *)      error "usage: screenpush detect|state|switch|switch-raw|reachable|save-desk" ;;
  esac
}

################################################################################
# Helper Functions
################################################################################

# No "Error:" prefix: every message here is shown to a person verbatim by the
# panel, as a line under the row they clicked.
error() { echo "${1}" >&2; exit 1; }

# The desk in force for this invocation, so messages can name screens the way
# the person named them. Set by the commands that resolve a desk.
CURRENT_DESK="null"

# "Left screen" rather than a serial nobody knows. Falls back to the serial
# when the desk does not know the screen.
screen_label() {
  local l
  l=$(printf '%s' "$CURRENT_DESK" | jq -r --arg s "$1" '[.monitors[]? | select(.serial == $s) | .label][0] // ""' 2>/dev/null || true)
  [ -n "$l" ] && printf '%s' "$l" || printf '%s' "$1"
}

# "HDMI 1" rather than 0x11. Same table the setup sheet uses.
input_label() {
  case "$1" in
    0x01) echo "VGA 1" ;; 0x03) echo "DVI 1" ;; 0x04) echo "DVI 2" ;;
    0x0f) echo "DisplayPort 1" ;; 0x10) echo "DisplayPort 2" ;;
    0x11) echo "HDMI 1" ;; 0x12) echo "HDMI 2" ;; 0x1b) echo "USB-C" ;;
    *) echo "$1" ;;
  esac
}

# Why zero screens answered, when that is the case. Being outside the i2c
# group is by far the usual reason, and ddcutil reports it as "no displays".
no_screens_hint() {
  if ! id -nG 2>/dev/null | tr ' ' '\n' | grep -qx i2c; then
    echo "No screens answered. Add your user to the i2c group and log in again."
  else
    echo "No screens answered. Check DDC/CI is turned on in each screen's own menu."
  fi
}

require_deps() {
  command -v ddcutil >/dev/null || error "ddcutil isn't installed. Install it with: sudo pacman -S ddcutil"
  command -v jq >/dev/null || error "jq isn't installed. Install it with: sudo pacman -S jq"
}

################################################################################
# Core Functions
################################################################################

# The screens on this computer, found from the kernel rather than by asking
# ddcutil to look.
#
# `ddcutil detect`, and every `ddcutil --sn`, opens every I2C bus on the
# machine to find the screens. On an AMD RDNA4 card (RX 9070, Radeon AI PRO
# R9700) two of those buses belong to the card's own power controller, named
# "AMDGPU SMU 0" and "AMDGPU SMU 1". Probing them wedges the controller and the
# card drops off the PCIe bus, which is a hard crash of the whole desktop
# (ddcutil issues #194 and #629). So the engine never scans. The kernel already
# knows which connector each screen is on, its EDID (serial and model), and
# which I2C bus reaches it; every ddcutil call names that one bus with --bus.
#
# A screen is present when its connector says "connected" and its EDID carries
# a serial. A screen off at the wall drops its connection, which matches what
# `detect` used to report.
#
# The roots are overridable so the tests can build a fake tree.
DRM_ROOT=${SCREENPUSH_DRM_ROOT:-/sys/class/drm}
I2C_ROOT=${SCREENPUSH_I2C_ROOT:-/sys/bus/i2c/devices}

# A monitor, or anything pretending to be one on the I2C bus, chooses how much
# it answers with. Cap every read here, at the producer, so neither this script
# nor the shell that reads its output holds an unbounded string.
DDC_MAX_BYTES=131072
ddc() { ddcutil "$@" 2>/dev/null | head -c "$DDC_MAX_BYTES" || true; }

# One text descriptor from the base EDID block: tag ff is the serial, fc the
# model. Bytes after the 5-byte header, up to a newline, printable ASCII only,
# trailing spaces trimmed - the same text ddcutil printed as "Serial number"
# and "Model".
edid_text() {
  local file="$1" tag="$2"
  head -c 128 -- "$file" 2>/dev/null | od -An -v -tx1 | awk -v tag="$tag" '
    { for (i = 1; i <= NF; i++) b[n++] = $i }
    END {
      hex = "0123456789abcdef"
      if (n < 128) exit
      for (d = 54; d <= 108; d += 18) {
        if (b[d] != "00" || b[d+1] != "00" || b[d+2] != "00" || b[d+3] != tag) continue
        out = ""
        for (i = d + 5; i < d + 18; i++) {
          if (b[i] == "0a") break
          c = (index(hex, substr(b[i], 1, 1)) - 1) * 16 + index(hex, substr(b[i], 2, 1)) - 1
          if (c < 32 || c > 126) { out = ""; break }
          out = out sprintf("%c", c)
        }
        sub(/ +$/, "", out)
        print out
        exit
      }
    }'
}

# The I2C bus that carries DDC for one connector. DisplayPort's is the AUX
# channel, which the kernel exposes as an i2c-N directory inside the connector;
# HDMI and DVI use the `ddc` link. The AUX bus comes first: on DisplayPort the
# `ddc` link points at the physical DDC pins, which are not wired.
#
# Any bus the kernel names as the card's power controller is refused, whatever
# path led to it. That is the bus that crashes the card.
connector_bus() {
  local dir="$1" bus="" f name
  for f in "$dir"/i2c-*; do
    [ -d "$f" ] || continue
    bus=${f##*/i2c-}; break
  done
  if [ -z "$bus" ] && [ -L "$dir/ddc" ]; then
    f=$(readlink -- "$dir/ddc"); bus=${f##*/i2c-}
  fi
  [[ "$bus" =~ ^[0-9]+$ ]] || return 0
  name=$(head -c 128 -- "$I2C_ROOT/i2c-$bus/name" 2>/dev/null || true)
  [[ "$name" != *SMU* ]] || return 0
  printf '%s' "$bus"
}

# serial<TAB>model<TAB>bus for every connected screen, run at most once per
# invocation. The cache must be primed by the COMMAND, not lazily by the
# helpers: present_serials is read through `$(...)` and `< <(...)`, both of
# which run in a subshell, so an assignment made there is discarded.
DISPLAYS_CACHE=""
DISPLAYS_PRIMED=0

scan_displays() {
  local dir status serial model bus
  for dir in "$DRM_ROOT"/card*-*; do
    [ -f "$dir/status" ] || continue
    status=$(head -c 32 -- "$dir/status" 2>/dev/null || true)
    [ "$status" = "connected" ] || continue
    serial=$(edid_text "$dir/edid" ff)
    [ -n "$serial" ] || continue
    bus=$(connector_bus "$dir")
    [ -n "$bus" ] || continue
    model=$(edid_text "$dir/edid" fc)
    printf '%s\t%s\t%s\n' "$serial" "$model" "$bus"
  done
}

prime_displays() {
  [ "$DISPLAYS_PRIMED" -eq 1 ] && return 0
  DISPLAYS_CACHE=$(scan_displays)
  DISPLAYS_PRIMED=1
}

displays() {
  if [ "$DISPLAYS_PRIMED" -eq 1 ]; then
    [ -z "$DISPLAYS_CACHE" ] || printf '%s\n' "$DISPLAYS_CACHE"
  else
    scan_displays
  fi
}

# Serials of every connected screen, one per line. A panel whose EDID has no
# serial is left out: it cannot be told apart from its neighbours, and a blank
# serial would add a phantom row to the setup grid.
present_serials() {
  displays | cut -f1
}

# The bus for a serial. When two screens report the same serial this is
# ambiguous, which verify_unique_serials refuses before anything is sent.
bus_for() {
  displays | awk -F'\t' -v s="$1" '$1 == s { print $3; exit }'
}

# ddcutil against one screen's own bus. A screen with no known bus gets no
# call at all, never a fallback to a lookup by serial, which would scan.
ddc_screen() {
  local serial="$1" bus
  shift
  bus=$(bus_for "$serial")
  [ -n "$bus" ] || return 0
  ddc --bus "$bus" "$@"
}

# Two monitors reporting the same serial cannot be told apart in the desk
# file, which keys every input by serial. Caught here, at the start, rather
# than as a confusing mid-switch failure with some screens already moved.
verify_unique_serials() {
  local dupes
  dupes=$(present_serials | sort | uniq -d | paste -sd ', ' -)
  [ -z "$dupes" ] \
    || error "Two screens report the same serial number (${dupes}), so Screen Push can't tell them apart."
}

# serial<TAB>model for every connected screen, one per line.
monitor_records() {
  displays | cut -f1,2
}

# The input codes a monitor reports it actually has. Sending a code a panel
# lacks blacks it with no display left to recover on, so this list is the
# only source the setup screen ever offers.
#
# ddcutil prints them as BARE hex nested under a "Values:" line, not as the
# 0x-prefixed codes it accepts on the way back in:
#
#     Feature: 60 (Input Source)
#        Values:
#           0f: DisplayPort-1
#           11: HDMI-1
#     Feature: 62 (Audio speaker volume)
#
# So the code is re-prefixed and lower-cased here. Everything downstream
# compares 0x-prefixed lowercase, and a parser that emitted "0f" would make
# every capability check silently fail closed.
capabilities_for() {
  ddc_screen "$1" capabilities \
    | awk '
        /^[[:space:]]*Feature:[[:space:]]*60/ { inblock = 1; next }
        /^[[:space:]]*Feature:/               { inblock = 0 }
        inblock && /^[[:space:]]*[0-9a-fA-F][0-9a-fA-F]:/ {
          code = $1; sub(":", "", code); print "0x" tolower(code)
        }' || true
}

cmd_detect() {
  prime_displays
  if [ -z "$(present_serials)" ]; then
    jq -n -c --arg hint "$(no_screens_hint)" '{monitors: [], hint: $hint}'
    return 0
  fi

  local serial model codes
  {
    echo '{"monitors":['
    local first=1
    while IFS=$'\t' read -r serial model; do
      [ -n "$serial" ] || continue
      codes=$(capabilities_for "$serial" | jq -R . | jq -s -c .)
      [ $first -eq 1 ] || echo ','
      first=0
      printf '{"serial":%s,"model":%s,"inputs":%s}' \
        "$(printf '%s' "$serial" | jq -R .)" "$(printf '%s' "$model" | jq -R .)" "$codes"
    done < <(monitor_records)
    echo ']}'
  } | jq -c .
}

# The input each monitor is on right now, as {serial: code}. A monitor that
# does not answer is omitted rather than guessed at.
live_inputs() {
  local serial code
  {
    echo '{'
    local first=1
    while read -r serial; do
      [ -n "$serial" ] || continue
      code=$(read_input "$serial")
      [ -n "$code" ] || continue
      [ $first -eq 1 ] || echo ','
      first=0
      printf '%s:%s' "$(printf '%s' "$serial" | jq -R .)" "$(printf '%s' "$code" | jq -R .)"
    done < <(present_serials)
    echo '}'
  } | jq -c .
}

read_input() {
  ddc_screen "$1" getvcp 60 \
    | grep -o 'sl=0x[0-9a-fA-F]*' | cut -d= -f2 | tr 'A-F' 'a-f' || true
}

# Which configured computer matches what every monitor is showing. Null when
# the desk is split across computers, which is a real state after a partial
# manual change on the monitor's own menu.
#
# The comparison iterates the COMPUTER's inputs, not the live map, and that
# direction is the whole point. Iterating live only checks the monitors that
# answered, so a desk with one panel asleep would match a computer on the
# strength of the other panel alone - and confidently report the wrong machine
# while the sleeping panel sits on a different one. Walking the computer's own
# inputs means every monitor it claims must be present AND matching, so an
# unanswered monitor yields null: honest, rather than wrong.
#
# The length guard matters too: a computer added in the setup grid but not yet
# filled in has an empty inputs map, and `all` over an empty list is true, so
# without it every blank computer would match everything.
cmd_state() {
  prime_displays

  local key desk live
  key=$(desk_key)
  desk=$(desk_json "$key")
  live=$(live_inputs)

  local hint=""
  [ -n "$key" ] || hint=$(no_screens_hint)
  jq -n -c --arg key "$key" --arg hint "$hint" --argjson desk "$desk" --argjson live "$live" '
    ($desk.computers // []) as $computers
    | {
        deskKey: $key,
        hint: $hint,
        known: ($desk != null),
        label: ($desk.label // ""),
        monitors: ($desk.monitors // []),
        computers: $computers,
        live: $live,
        # Screens answering DDC that the stored desk has never seen. A desk
        # resolves on partial overlap on purpose (a third screen must not wipe
        # the setup), so these are the screens a switch will leave behind.
        # The menu warns and proceeds; refusing would strand the whole desk
        # for one new cable.
        unmapped: (
          [ ($live | keys[]) as $s
            | select(([ ($desk.monitors // [])[] | .serial ] | index($s)) == null)
            | $s ] | sort
        ),
        current: (
          if ($live | length) == 0 then null
          else
            [ $computers[]
              | select(. as $c
                  | ($c.inputs | length) > 0
                    and ($c.inputs | to_entries | map($live[.key] == .value) | all))
              | .id
            ] | first // null
          end
        )
      }'
}

# Every monitor must answer BEFORE any of them moves. Without this a faulty
# panel fails mid-loop having already moved the others, leaving the desk split
# across two computers - the state that is hardest to get out of, because the
# person is now looking at two machines at once and neither has all the screens.
#
# "Every monitor" means every monitor `present_serials` lists, which is every
# monitor that is powered on. It deliberately does NOT mean every monitor the
# stored desk knows about: desk_json resolves a desk by subset, so a desk whose
# second screen is switched off still resolves, and that dark screen must not
# be allowed to veto a switch. DDC cannot distinguish a fault from a power-off,
# so presence in the display list is the only line available - and it is the
# right one, because a monitor that is off shows nothing whichever input it is
# set to.
verify_all_present() {
  local missing=() serial
  for serial in "$@"; do
    [ -n "$(read_input "$serial")" ] || missing+=("$serial")
  done
  [ ${#missing[@]} -eq 0 ] && return 0
  local names=() m
  for m in "${missing[@]}"; do names+=("$(screen_label "$m")"); done
  error "Nothing was moved. $(IFS=,; echo "${names[*]}" | sed 's/,/, /g') isn't answering. Check it is on and DDC/CI is enabled in its menu."
}

# A code a panel does not have blacks it, with no display left to recover on.
# The setup screen only ever offers real codes, so reaching here means the
# desk file is stale - a cable moved, or a monitor was swapped for a different
# model with the same position.
verify_codes() {
  local serial code
  while [ $# -gt 0 ]; do
    serial="$1"; code="$2"; shift 2
    # Shape before membership. A code is exactly "0x" plus two hex digits;
    # anything else is refused outright, before it ever reaches grep. This
    # matters because `grep -qx` treats an embedded newline in the pattern
    # as alternation between the lines either side of it - so a code that is
    # really two valid codes joined by a newline (the shape a duplicate
    # computer id produces) would otherwise sail through the membership
    # check by matching one of its own halves.
    [[ "$code" =~ ^0x[0-9a-fA-F][0-9a-fA-F]$ ]] \
      || error "The saved input for $(screen_label "$serial") is damaged. Open Set up this desk and save it again."
    capabilities_for "$serial" | grep -qx "$code" \
      || error "$(screen_label "$serial") no longer offers $(input_label "$code"). Open Set up this desk and pick a new input for it."
  done
}

# Two switches interleaving on the same I2C buses - a hotkey pressed while the
# menu is mid-switch, or the two per-monitor bar instances both firing - can
# leave the desk split across computers. Serialised on an flock of the
# screenpush config directory, held by the desk file helper for as long as
# this script, re-run beneath it, takes.
with_switch_lock() {
  if [ "${SCREENPUSH_LOCK_HELD:-}" = 1 ]; then
    "$@"
    return
  fi
  local sub=switch-raw
  [ "$1" = cmd_switch_raw ] || sub=switch
  shift
  exec /usr/bin/python3 -I -S "$DESKFILE" lock \
    /usr/bin/env SCREENPUSH_LOCK_HELD=1 "$(readlink -f "$0")" "$sub" "$@"
}

cmd_switch() {
  local target="${1:-}" only=""
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --screen|--monitor)
        [ $# -ge 2 ] || error "usage: screenpush switch <computer> [--screen <serial>]"
        only="$2"; shift 2 ;;
      *) error "unknown option: $1" ;;
    esac
  done
  [ -n "$target" ] || error "usage: screenpush switch <computer> [--screen <serial>]"

  prime_displays
  verify_unique_serials

  local key desk computer
  key=$(desk_key)
  desk=$(desk_json "$key")
  [ "$desk" != "null" ] || error "This desk hasn't been set up yet. Click the icon and choose Set up this desk."
  CURRENT_DESK="$desk"

  # Select into an array first so a duplicate id in the desk file is caught
  # here rather than downstream. `select(...)` alone would emit one JSON
  # document per match, and every field read from $computer afterwards -
  # including the code handed to `ddcutil setvcp` - would silently inherit
  # every match's value joined by a newline. The desk file can be
  # hand-edited or written by a future version, so this check is the one
  # that actually matters; the setup screen deriving unique ids is only the
  # first line of defence, not the only one.
  local matches match_count
  matches=$(printf '%s' "$desk" | jq -c --arg id "$target" '[.computers[] | select(.id == $id)]')
  match_count=$(printf '%s' "$matches" | jq 'length')
  [ "$match_count" -gt 0 ] || error "There's no computer called '${target}' on this desk. Check its id in Set up this desk."
  [ "$match_count" -eq 1 ] \
    || error "Two computers on this desk share the id '${target}'. Open Set up this desk and remove one."
  computer=$(printf '%s' "$matches" | jq -c '.[0]')

  local pairs=() serial code
  while read -r serial; do
    [ -n "$serial" ] || continue
    if [ -n "$only" ] && [ "$serial" != "$only" ]; then continue; fi
    code=$(printf '%s' "$computer" | jq -r --arg s "$serial" '.inputs[$s] // empty')
    # A monitor with no recorded input for this computer is one that cannot be
    # switched, or one added since setup. Skipping keeps the rest of the desk
    # working; refusing would make one unswitchable panel disable the product.
    [ -n "$code" ] || continue
    pairs+=("$serial" "$code")
  done < <(present_serials)

  [ ${#pairs[@]} -gt 0 ] || error "This computer has no screens set up. Open Set up this desk and pick an input for each screen."

  local serials=()
  for ((i = 0; i < ${#pairs[@]}; i += 2)); do serials+=("${pairs[i]}"); done

  verify_all_present "${serials[@]}"
  verify_codes "${pairs[@]}"

  for ((i = 0; i < ${#pairs[@]}; i += 2)); do
    ddcutil --bus "$(bus_for "${pairs[i]}")" setvcp 60 "${pairs[i+1]}" \
      || error "Couldn't switch $(screen_label "${pairs[i]}"). Screens already moved stay moved; use its own menu to bring it back."
  done
}

# Set one monitor to a literal code. Used by the setup screen's "Try it",
# where the value being tested has not been saved to any computer yet.
# Capability checking is kept: an unsupported code blacks the panel whether
# or not it came from a saved desk.
cmd_switch_raw() {
  local serial="${1:-}" code="${2:-}"
  [ -n "$serial" ] || error "usage: screenpush switch-raw <serial> <code>"
  [ -n "$code" ] || error "usage: screenpush switch-raw <serial> <code>"

  prime_displays
  CURRENT_DESK=$(desk_json "$(desk_key)")
  verify_all_present "$serial"
  verify_codes "$serial" "$code"

  ddcutil --bus "$(bus_for "$serial")" setvcp 60 "$code" \
    || error "Couldn't switch $(screen_label "$serial"). Use its own menu to switch it by hand."
}

# A computer that is off still has a named input, and sending the screens
# there is a black desk. This is advisory only: the answer drives a
# confirmation, never a refusal, because wanting to wake a machine by
# handing it the screens is a real thing to want.
cmd_reachable() {
  local target="${1:-}"
  [ -n "$target" ] || error "usage: screenpush reachable <computer>"

  prime_displays
  local desk host
  desk=$(desk_json "$(desk_key)")
  [ "$desk" != "null" ] || error "This desk hasn't been set up yet. Click the icon and choose Set up this desk."

  host=$(printf '%s' "$desk" | jq -r --arg id "$target" '[.computers[] | select(.id == $id)][0].host // ""')
  [ -n "$host" ] || return 0

  ping -c 1 -W 1 "$host" >/dev/null 2>&1
}

# The helper merges this desk in under the directory lock and publishes by
# rename, so a crash or a full disk leaves the old desk file intact instead of
# a half-written one - and a half-written desk file means no menu and no way
# back to a working desk.
cmd_save_desk() {
  local incoming key
  incoming=$(head -c 262145)
  printf '%s' "$incoming" | jq -e . >/dev/null 2>&1 \
    || error "Couldn't save: the desk data was unreadable. Try Save again."

  key=$(desk_key)
  [ -n "$key" ] || error "$(no_screens_hint) Nothing was saved."

  printf '%s' "$incoming" | /usr/bin/python3 -I -S "$DESKFILE" save "$key" \
    || exit 1
}

################################################################################
# Script Execution
################################################################################

main "$@"
