#!/usr/bin/env bash
# Fake ddcutil for tests. Understands only what the engine calls:
#   ddcutil --bus N getvcp 60
#   ddcutil --bus N setvcp 60 CODE
#   ddcutil --bus N capabilities
# `detect` and `--sn` scan every I2C bus, which crashes RDNA4 cards, so they
# are refused here and logged; the tests assert the log never shows them.
# Every call is appended to $STUB_LOG.
#
# The bus is mapped to a serial through $STUB_BUSMAP, written by
# test/stub/screenpush. State lives in $STUB_STATE/<serial> (current code) and
# $STUB_CAPS (lines of "SERIAL code code code"). A state file containing the
# literal "UNRESPONSIVE" is present but silent on getvcp/setvcp, which is how a
# genuine DDC fault is tested.
set -uo pipefail

# Guarded with :- so running this stub outside the test fixture fails with a
# readable message rather than bash's raw "unbound variable".
: "${STUB_STATE:?stub: STUB_STATE is not set - run this from the bats fixture}"
: "${STUB_CAPS:?stub: STUB_CAPS is not set - run this from the bats fixture}"
: "${STUB_BUSMAP:?stub: STUB_BUSMAP is not set - run the engine through test/stub/screenpush}"

[ -z "${STUB_LOG:-}" ] || echo "$*" >> "$STUB_LOG"

caps_for() { grep "^$1 " "$STUB_CAPS" 2>/dev/null | cut -d' ' -f2- || true; }

serial="" ; shift_to_cmd=()
while [ $# -gt 0 ]; do
  case "$1" in
    --bus) serial=$(awk -v b="$2" '$1 == b { print $2; exit }' "$STUB_BUSMAP"); shift 2 ;;
    --sn|detect) echo "stub: $1 scans every bus and is forbidden" >&2; exit 99 ;;
    *) shift_to_cmd+=("$1"); shift ;;
  esac
done
set -- "${shift_to_cmd[@]}"

state_file="$STUB_STATE/$serial"

case "${1:-}" in
  getvcp)
    [ -f "$state_file" ] || { echo "DDC communication failed" >&2; exit 1; }
    [ "$(cat "$state_file")" != "UNRESPONSIVE" ] || { echo "DDC communication failed" >&2; exit 1; }
    printf 'VCP code 0x60 (Input Source                  ): Input-%s (sl=%s)\n' \
      "$(sed 's/^0x//' "$state_file")" "$(cat "$state_file")"
    ;;
  setvcp)
    [ -f "$state_file" ] || { echo "DDC communication failed" >&2; exit 1; }
    [ "$(cat "$state_file")" != "UNRESPONSIVE" ] || { echo "DDC communication failed" >&2; exit 1; }
    echo "$3" > "$state_file"
    ;;
  capabilities)
    codes=$(caps_for "$serial")
    [ -n "$codes" ] || { echo "DDC communication failed" >&2; exit 1; }
    # Byte-faithful to real ddcutil: bare hex under "Values:", and a
    # following Feature line so the parser's block-exit is exercised too.
    echo "   Feature: 60 (Input Source)"
    echo "      Values:"
    for c in $codes; do printf '         %s: Input-%s\n' "${c#0x}" "${c#0x}"; done
    echo "   Feature: 62 (Audio speaker volume)"
    ;;
  *) echo "stub: unhandled args: $*" >&2; exit 2 ;;
esac
